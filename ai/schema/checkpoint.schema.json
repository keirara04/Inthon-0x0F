{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "checkpoint.schema.json",
  "title": "CheckpointResult",
  "description": "카메라 프레임 한 장에서 읽은 표지와 랜드마크 매칭 결과",
  "type": "object",
  "additionalProperties": false,
  "required": ["text", "kind", "matched_node_id", "match", "confidence"],
  "properties": {
    "text": { "type": ["string", "null"], "description": "표지에서 읽은 텍스트. 읽을 표지가 없으면 null" },
    "kind": { "type": "string", "enum": ["room_no", "floor_sign", "elevator_sign", "stairs_sign", "none"] },
    "matched_node_id": { "type": ["string", "null"], "description": "landmarks 목록에서 일치한 node_id. 없으면 null" },
    "match": { "type": "boolean", "description": "matched_node_id == expected_node_id" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
